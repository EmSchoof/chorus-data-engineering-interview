[0m08:24:17.268469 [debug] [Thread-3 (]: On model.chorus_data_engineer_interview.dim_person_task_summary: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "chorus_data_engineer_interview", "target_name": "dev", "node_id": "model.chorus_data_engineer_interview.dim_person_task_summary"} */

  create view "postgres"."public"."dim_person_task_summary__dbt_tmp"
    
    
  as (
    -- Person-Task summary
-- Shows completion rate and next occurrence for each person's tasks

WITH completion_summary AS (
  SELECT
    person_id,
    person_name,
    task_id,
    task_name,
    COUNT(*) AS total_occurrences,
    SUM(is_completed) AS completed_occurrences,
    ROUND(100.0 * SUM(is_completed) / COUNT(*), 2) AS completion_rate,
    MAX(CASE WHEN status != 'Completed' THEN occurrence_date END) AS next_occurrence
  FROM "postgres"."public"."fct_task_occurrences"
  GROUP BY person_id, person_name, task_id, task_name
)
SELECT
  person_id,
  person_name,
  task_id,
  task_name,
  total_occurrences,
  completed_occurrences,
  completion_rate,
  next_occurrence,
  CASE 
    WHEN completion_rate = 100 THEN 'On Track'
    WHEN completion_rate >= 75 THEN 'Good'
    WHEN completion_rate >= 50 THEN 'Needs Attention'
    ELSE 'At Risk'
  END AS health_status
FROM completion_summary
ORDER BY person_id, task_id
  );
