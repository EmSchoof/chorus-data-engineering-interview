  create view "postgres"."public"."encounters_per_specific_patient__dbt_tmp"
    
    
  as (
    /*
Given a patient_id, retrieve all encounters for that patient, including the status and encounter date.
*/

SELECT
  id,
  status,
  encounter_date
FROM "postgres"."public"."Patient"
JOIN "postgres"."public"."Encounter"
    ON "postgres"."public"."Patient".id = "postgres"."public"."Encounter".patient_id
WHERE "postgres"."public"."Patient".id = {var('patient_id')}
  );
