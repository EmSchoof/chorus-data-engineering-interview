[0m19:18:45.979428 [debug] [Thread-2 (]: On model.chorus_data_engineer_interview.avg_encounter_per_patient: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "chorus_data_engineer_interview", "target_name": "dev", "node_id": "model.chorus_data_engineer_interview.avg_encounter_per_patient"} */

  create view "postgres"."public"."avg_encounter_per_patient__dbt_tmp"
    
    
  as (
    /*
 Calculate the average number of encounters per patient, rounded to two decimal places.
 */

WITH encounter_counts AS (
    SELECT
        patient_id,
        COUNT(*) AS encounter_count
    FROM "postgres"."public"."Encounter"
    GROUP BY patient_id
)

SELECT
    ROUND(AVG(encounter_count), 2) AS avg_encounters_per_patient
FROM encounter_counts
  );
