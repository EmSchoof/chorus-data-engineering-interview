  create view "postgres"."public"."observations_per_specific_patient__dbt_tmp"
    
    
  as (
    /*
Write a query to fetch all observations for a given patient_id, showing the observation type, value, unit, and recorded date.
*/

SELECT
  patient_id,
  type,
  value,
  unit,
  recorded_at
FROM "postgres"."public"."Patient"
JOIN "postgres"."public"."Observation"
